# Runtime
NODE_ENV=production
PORT=4000
API_URL=https://api.myriderguy.com
APP_URL=https://myriderguy.com
CORS_ORIGINS=https://myriderguy.com,https://admin.myriderguy.com

# Database and cache - create new values for the replacement server
DATABASE_URL=postgresql://riderguy:replace-with-new-password@127.0.0.1:5432/riderguy
REDIS_URL=redis://:replace-with-new-password@127.0.0.1:6379

# Authentication - generate new independent random secrets
JWT_ACCESS_SECRET=replace-with-new-random-secret
JWT_REFRESH_SECRET=replace-with-new-random-secret

# Google
GOOGLE_CLIENT_IDS=replace-with-rider-web-client-id,replace-with-client-web-client-id
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Email
GMAIL_USER=developer@myriderguy.com
GMAIL_APP_PASSWORD=replace-with-new-app-password
EMAIL_FROM=developer@myriderguy.com

# SMS
MNOTIFY_API_KEY=replace-with-new-key
MNOTIFY_SENDER_ID=RiderGuy

# Payments
PAYSTACK_PUBLIC_KEY=replace-with-public-key
PAYSTACK_SECRET_KEY=replace-with-new-secret-key

# Firebase Admin — direct FCM, one credential set per native app project
FIREBASE_RIDER_PROJECT_ID=riderguy-rider
FIREBASE_RIDER_CLIENT_EMAIL=replace-with-rider-service-account-email
FIREBASE_RIDER_PRIVATE_KEY="replace-with-rider-private-key"
FIREBASE_CLIENT_PROJECT_ID=riderguy-client
FIREBASE_CLIENT_CLIENT_EMAIL=replace-with-client-service-account-email
FIREBASE_CLIENT_PRIVATE_KEY="replace-with-client-private-key"

# Uploads
UPLOAD_DIR=/var/www/riderguy/uploads
UPLOAD_BASE_URL=https://api.myriderguy.com/uploads

# Optional integrations and monitoring
SENTRY_DSN=
SOURCEID_BASE_URL=
SOURCEID_API_KEY=

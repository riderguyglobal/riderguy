{
  "name": "riderguy",
  "version": "1.0.0",
  "private": true,
  "description": "RiderGuy — 4-in-1 delivery rider career platform",
  "author": "RiderGuy Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "agents/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "npm run generate --workspace=@riderguy/database",
    "db:push": "npm run push --workspace=@riderguy/database",
    "db:migrate": "npm run migrate --workspace=@riderguy/database",
    "db:seed": "npm run seed --workspace=@riderguy/database",
    "db:studio": "npm run studio --workspace=@riderguy/database"
  },
  "devDependencies": {
    "@expo/config-plugins": "54.0.5",
    "@types/react": "~19.1.17",
    "browserslist": "4.28.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "marked": "^17.0.4",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "postcss-selector-parser": "6.1.4",
    "qs": "6.16.0",
    "prisma": "6.12.0",
    "puppeteer-core": "^25.9.0",
    "rimraf": "^6.0.0",
    "sharp": "^0.35.3",
    "turbo": "^2.3.0"
  },
  "overrides": {
    "@expo/metro": "54.2.0",
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "postcss": "8.5.26",
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "protobufjs": "7.6.5",
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "websocket-driver": "0.7.5",
    "esbuild": "0.28.2",
    "ws": "8.21.3",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@10.8.0"
}

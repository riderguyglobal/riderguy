{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myriderguy.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.myriderguy.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "822237251244-avsri95hle6007j1nnegv82g2t59unvp.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myriderguy.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.myriderguy.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "822237251244-avsri95hle6007j1nnegv82g2t59unvp.apps.googleusercontent.com",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myriderguy.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.myriderguy.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "822237251244-avsri95hle6007j1nnegv82g2t59unvp.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "calbrixintelligence@gmail.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "internal"
      }
    }
  }
}

{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myriderguy.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.myriderguy.com",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "preview": {
      "node": "22.14.0",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myriderguy.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.myriderguy.com",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "play-internal": {
      "node": "22.14.0",
      "environment": "production",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myriderguy.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.myriderguy.com",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal"
      }
    }
  }
}

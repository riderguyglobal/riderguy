# ===========================================
# RiderGuy Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ===========================================

# ---- General ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (PostgreSQL 16 — self-hosted on Hetzner) ----
# For local development, point to your local PostgreSQL or the Hetzner server.
# In production, this connects to the local PostgreSQL instance on the VPS.
DATABASE_URL=postgresql://riderguy:your-password@127.0.0.1:5432/riderguy_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-change-me
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# ---- File Storage (S3-compatible: AWS S3, Cloudflare R2) ----
S3_BUCKET_NAME=riderguy-uploads
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# ---- Payments ----
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx

# ---- Optional paid Maps Platform integration ----
# The launch-safe default uses RiderGuy's local Ghana gazetteer, approximate
# road distances, device GPS, and external navigation links without billing.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# ---- Google OAuth ----
# Must be the "Web application" OAuth client ID from Google Cloud Console — this is the
# audience the API verifies native Google Sign-In ID tokens against (see
# apps/api/src/services/auth.service.ts authenticateWithGoogle). Rider and Client each use
# their own value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (set in that app's eas.json),
# configured via @react-native-google-signin/google-signin's `webClientId`.
GOOGLE_CLIENT_IDS=your-rider-web-client-id.apps.googleusercontent.com,your-client-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Email (Gmail / Google Workspace SMTP) ----
# GMAIL_USER is the Workspace account nodemailer authenticates as (an app password,
# not the account password — requires 2-Step Verification enabled on that account).
# EMAIL_FROM is the visible From address; it must be GMAIL_USER itself or a verified
# "Send mail as" alias on that account, otherwise Gmail silently rewrites the From header.
GMAIL_USER=developer@myriderguy.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=developer@myriderguy.com

# ---- SMS (mNotify — Ghana) ----
MNOTIFY_API_KEY=xxx
MNOTIFY_SENDER_ID=RiderGuy

# ---- 21st Agents ----
API_KEY_21ST=21st_sk_your-key-here

# ---- Monitoring (Sentry) ----
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ---- WebAuthn (Biometric / Passkey Login) ----
WEBAUTHN_RP_NAME=RiderGuy
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3002,http://localhost:3000

# ---- Push Notifications (Firebase Admin / direct FCM) ----
# The native apps use different Firebase projects, so the API must initialise
# one Admin SDK client per project. These are server credentials; they are not
# the EAS FCM V1 credential used by Expo Push Service.
FIREBASE_RIDER_PROJECT_ID=riderguy-rider
FIREBASE_RIDER_CLIENT_EMAIL=firebase-adminsdk-rider@example.iam.gserviceaccount.com
FIREBASE_RIDER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_PROJECT_ID=riderguy-client
FIREBASE_CLIENT_CLIENT_EMAIL=firebase-adminsdk-client@example.iam.gserviceaccount.com
FIREBASE_CLIENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
# Legacy single-project values (non-native/backwards compatibility only).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=xxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxx
NEXT_PUBLIC_FIREBASE_APP_ID=xxx
NEXT_PUBLIC_FIREBASE_VAPID_KEY=xxx
